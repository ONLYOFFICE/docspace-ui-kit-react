{
  "projectId": "d44ca729-67df-4f9a-b452-056b215ace9c",
  "pkg": "@onlyoffice/apps-ui-kit",
  "globalName": "AppsUiKit",
  "shape": "storybook",
  "storybookConfigDir": ".storybook",
  "storybookStatic": ".design-sync/sb-reference",
  "buildCmd": "pnpm build",
  "entry": "./dist/esm/index.js",
  "cssEntry": "./dist/styles.css",
  "extraFonts": ["./css/fonts.css"],
  "extraEntries": ["./.design-sync/preview-context.mjs"],
  "provider": {
    "component": "TranslationProvider",
    "props": {
      "locale": "en",
      "translations": {
        "$ref": "previewTranslations"
      }
    },
    "inner": {
      "component": "ThemeProviderComponent",
      "props": {
        "theme": {
          "$ref": "previewTheme"
        },
        "currentColorScheme": {
          "$ref": "previewColorScheme"
        }
      }
    }
  },
  "titleMap": {
    "Circle": "CircleSkeleton",
    "Rectangle": "RectangleSkeleton",
    "Filter": "FilterInput",
    "InfiniteLoader": "InfiniteLoaderComponent",
    "TopLoader": "TopLoaderService",
    "ErrorOffline": "ErrorOfflineContainer",
    "ErrorProvider": "ErrorBoundary",
    "ArticleItem": null,
    "GroupMenuItem": null,
    "TableHeaderCell": null,
    "TableSettings": null,
    "TilesSkeleton": null,
    "AIChat": null,
    "AISettings": null,
    "Files": null,
    "Rooms": null,
    "Forms": null,
