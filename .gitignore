storybook-static
# locales/en is committed so the package builds, tests and runs Storybook with
# no DocSpace checkout next to it. Every other language is produced on demand by
# `pnpm sync-locales` and stays out of git.
locales/*
!locales/en
css
fonts
debug-storybook.log
.env
.env.local
# Pack output. The tarball is a build artifact; it is copied into the
# DocSpace client repository and committed there, never here.
onlyoffice-apps-ui-kit-*.tgz
