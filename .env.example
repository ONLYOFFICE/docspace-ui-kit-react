VITE_PROVIDER_API_URL=https://example.com
VITE_PROVIDER_API_KEY=sk-1234567890

# Path to the DocSpace/client checkout, used by scripts/copy-locales.js and
# scripts/copy-images.js to pull locales, fonts and icons for the build.
# Relative paths resolve from scripts/. Defaults to ../../DocSpace/client
# (a sibling of this repo) when unset.
DOCSPACE_CLIENT_ROOT=../DocSpace/client